# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git or share it in screenshots.

# Postgres (shared instance — used by n8n, Odoo will create its own DB inside it)
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password

# n8n basic auth (protects the n8n editor UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_to_a_strong_password

# App database used later for contacts / messages / conversations tables
LEADS_DB_NAME=whatsapp_leads

# Filled in later during Phase 2 (WhatsApp) and Phase 3 (Ollama) — placeholders for now
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
OLLAMA_MODEL=gemma3:4b
